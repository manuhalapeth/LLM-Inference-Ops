# Copy to .env on the GPU box and fill in. .env is git-ignored: never commit secrets.

# Model served by vLLM. Clients always call it by SERVED_MODEL_NAME.
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
SERVED_MODEL_NAME=llm

# Pin to an exact version (e.g. vllm/vllm-openai:v0.x.y) once the first run works,
# so results stay comparable across phases.
VLLM_IMAGE=vllm/vllm-openai:latest

# Which file in vllm/configs/ to use (without .yaml).
VLLM_CONFIG=baseline

# Only needed for gated models such as Llama.
HF_TOKEN=

GRAFANA_ADMIN_PASSWORD=change-me

# Hourly price of the rented GPU, used for $ per 1M tokens.
GPU_HOURLY_PRICE_USD=
